{
    "name": "wolinski/symfony-sudo-mode-demo",
    "description": "Runnable demo of Symfony 8.2 sudo mode: IS_AUTHENTICATED_RECENTLY and IS_AUTHENTICATED_VERY_RECENTLY",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/clock": "^8.1",
        "symfony/expression-language": "8.2.x-dev",
        "symfony/framework-bundle": "8.2.x-dev",
        "symfony/security-bundle": "8.2.x-dev",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "symfony/browser-kit": "^8.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
