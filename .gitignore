vendor/
var/

# composer.lock is committed on purpose: the constraints are 8.2.x-dev
# branches, so the lock file is the only thing that pins the commits a run
# used. Ignoring it would let `composer install` resolve the current branch
# heads, which move while 8.2 is unreleased.

# generated by the framework at runtime, for editors and IDEs only
